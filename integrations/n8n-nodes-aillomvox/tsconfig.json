{
    "compilerOptions": {
        "rootDirs": [
            "nodes",
            "credentials"
        ],
        "outDir": "dist",
        "target": "es2019",
        "lib": [
            "es2019",
            "dom"
        ],
        "module": "commonjs",
        "moduleResolution": "node",
        "allowJs": true,
        "checkJs": false,
        "strict": false,
        "noImplicitAny": false, // Relaxed for easier build in mixed envs
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "nodes/**/*",
        "credentials/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}